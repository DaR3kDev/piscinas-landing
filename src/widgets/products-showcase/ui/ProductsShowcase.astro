---
import { IconArrowRight, IconBrandWhatsapp } from '@tabler/icons-react'

const whatsappNumber = '573173552802'

const products = [
  {
    name: 'Producto para piscina',
    category: 'Mantenimiento',
    image: '/products/product-1.webp',
  },
  {
    name: 'Repuesto para piscina',
    category: 'Repuestos',
    image: '/products/product-2.webp',
  },
  {
    name: 'Accesorio para piscina',
    category: 'Accesorios',
    image: '/products/product-3.webp',
  },
  {
    name: 'Equipamiento para piscina',
    category: 'Equipamiento',
    image: '/products/product-4.webp',
  },
]

const getWhatsAppUrl = (productName: string) => {
  const message = `Hola, estoy interesado en ${productName}. ¿Podrían brindarme más información?`

  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`
}
---

<section
  id="productos"
  class="section-reveal border-b border-gray-200 bg-white"
>
  <div
    class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
  >
    <!-- Section header -->
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-2xl">
        <div class="mb-5 inline-flex items-center gap-3">
          <span
            class="h-px w-8 bg-gray-950"
            aria-hidden="true"
          ></span>

          <span
            class="text-sm font-medium tracking-wide text-gray-600"
          >
            Productos
          </span>
        </div>

        <h2
          class="text-3xl font-semibold tracking-[-0.02em] text-gray-950 sm:text-4xl lg:text-5xl"
        >
          Productos para cada necesidad.
        </h2>

        <p
          class="mt-5 text-base leading-7 text-gray-600 sm:text-lg sm:leading-8"
        >
          Explora algunos de nuestros productos y consulta
          disponibilidad directamente con nosotros.
        </p>
      </div>

      <a
        href="#contacto"
        class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-gray-950 transition-colors duration-200 hover:text-gray-600"
      >
        Ver catálogo

        <IconArrowRight
          className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>
    </div>

    <!-- Products grid -->
    <div
      class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4"
    >
      {
        products.map((product) => (
          <article class="group">
            <!-- Product image -->
            <a
              href={getWhatsAppUrl(product.name)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Consultar ${product.name} por WhatsApp`}
              class="block overflow-hidden rounded-xl bg-gray-50"
            >
              <div class="aspect-square">
                <img
                  src={product.image}
                  alt={product.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                />
              </div>
            </a>

            <!-- Product information -->
            <div class="mt-4">
              <p
                class="text-xs font-medium uppercase tracking-[0.08em] text-gray-500"
              >
                {product.category}
              </p>

              <h3 class="mt-1 text-base font-semibold text-gray-950">
                {product.name}
              </h3>

              <a
                href={getWhatsAppUrl(product.name)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-gray-950 transition-colors duration-200 hover:text-gray-600"
              >
                <IconBrandWhatsapp
                  className="h-4 w-4 transition-transform duration-200 group-hover:scale-105"
                />

                Consultar

                <IconArrowRight
                  className="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1"
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>